{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "mimo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MiMo",
      "options": {
        "baseURL": "https://token-plan-cn.xiaomimimo.com/v1",
        "apiKey": "{env:MIMO_API_KEY}"
      },
      "models": {
        "mimo-v2.5-pro": {
          "name": "mimo-v2.5-pro",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenAI",
      "options": {
        "baseURL": "https://sub2api.luchikey.com/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high"
          },
          "cost": {
            "input": 0.75,
            "output": 4.5,
            "cache_read": 0.075
          }
        },
        "gpt-5.5": {
          "name": "GPT-5.5",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high"
          },
          "cost": {
            "input": 5,
            "output": 30,
            "cache_read": 0.5
          }
        },
        "gpt-5.4": {
          "name": "GPT-5.4",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high"
          },
          "cost": {
            "input": 2.5,
            "output": 15,
            "cache_read": 0.25
          }
        },
        "gpt-5-mini": {
          "name": "GPT-5 Mini",
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high"
          },
          "cost": {
            "input": 0.25,
            "output": 2,
            "cache_read": 0.025
          }
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "whitelist": [
        "deepseek-v4-flash",
        "deepseek-v4-pro"
      ],
      "options": {
        "baseURL": "http://192.168.49.220/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        }
      }
    }
  },
  "model": "openai/gpt-5.4",
  "small_model": "openai/gpt-5.4",
  "share": "disabled",
  "plugin": [
    "./plugins/session-governance.ts"
  ],
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://context7-mcp--upstash.run.tools",
      "enabled": true
    },
    "repo-audit": {
      "type": "local",
      "command": [
        "python3",
        "~/Projects/repo-audit/server/mcp_server.py"
      ]
    },
    "sequential-thinking": {
      "type": "remote",
      "url": "https://server.smithery.ai/@smithery-ai/server-sequential-thinking",
      "enabled": true
    },
    "fastaicode-image": {
      "type": "local",
      "command": [
        "/usr/bin/python3",
        "~/Projects/Vincent/fastaicode-image-mcp/server/mcp_server.py"
      ],
      "environment": {
        "FASTAICODE_API_KEY": "{env:FASTAICODE_API_KEY}",
        "FASTAICODE_BASE_URL": "https://sub2api.luchikey.cn"
      },
      "timeout": 120000
    },
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@brave/brave-search-mcp-server",
        "--transport",
        "stdio"
      ],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": true,
      "timeout": 120000
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "enabled": true,
      "timeout": 120000
    }
  },
  "agent": {
    "coder": {
      "description": "负责代码实现与修复",
      "model": "openai/gpt-5.4",
      "prompt": "You are responsible for code implementation and bug fixing. Prefer the smallest correct change and add tests when needed. If dispatched as a subagent, follow the canonical shared English prompt template defined in references/ai/subagent-prompt-template.md and use English for task execution and output."
    },
    "reviewer": {
      "description": "负责代码审查与风险检查",
      "model": "openai/gpt-5.4",
      "prompt": "You perform review only. Focus on regression risks, edge cases, test gaps, and evidence quality. If dispatched as a subagent, follow the canonical shared English prompt template defined in references/ai/subagent-prompt-template.md and use English for task execution and output."
    },
    "openai-54": {
      "description": "OpenAI GPT-5.4，可切换模型入口",
      "model": "openai/gpt-5.4"
    },
    "openai-54-mini": {
      "description": "OpenAI GPT-5.4 Mini，可切换模型入口",
      "model": "openai/gpt-5.4-mini"
    },
    "openai-5-mini": {
      "description": "OpenAI GPT-5 Mini，可切换模型入口",
      "model": "openai/gpt-5-mini"
    },
    "openai-55": {
      "description": "OpenAI GPT-5.5，可切换模型入口",
      "model": "openai/gpt-5.5"
    },
    "deepseek-flash": {
      "description": "DeepSeek V4 Flash，可切换模型入口",
      "model": "deepseek/deepseek-v4-flash"
    },
    "deepseek-pro": {
      "description": "DeepSeek V4 Pro，可切换模型入口",
      "model": "deepseek/deepseek-v4-pro"
    },
    "ctf": {
      "description": "CTF 安全测试",
      "model": "openai/gpt-5.4"
    },
    "vibe-implement": {
      "description": "vibe技能的实现代理，执行已批准的设计和计划",
      "model": "openai/gpt-5.4",
      "prompt": "When dispatched as a subagent, follow the canonical shared English prompt template defined in references/ai/subagent-prompt-template.md. Respect the frozen requirement and plan artifacts, and keep internal task output in English."
    },
    "vibe-plan": {
      "description": "vibe技能的规划代理，需求分析、架构设计、制定计划",
      "model": "openai/gpt-5.4",
      "prompt": "When dispatched as a subagent, follow the canonical shared English prompt template defined in references/ai/subagent-prompt-template.md. Keep planning constraints explicit and keep internal task output in English."
    },
    "vibe-review": {
      "description": "vibe技能的审查代理，缺陷发现、回归检查、验证完整性",
      "model": "openai/gpt-5.4",
      "prompt": "When dispatched as a subagent, follow the canonical shared English prompt template defined in references/ai/subagent-prompt-template.md. Keep review output in English and prioritize defects, regressions, and proof gaps."
    }
  },
  "command": {
    "oai-54": {
      "description": "Run task with verified OpenAI GPT-5.4",
      "agent": "openai-54",
      "template": "Use the selected verified OpenAI 5.x model for this task.\n\nTask input:\n$ARGUMENTS"
    },
    "oai-54-mini": {
      "description": "Run task with verified OpenAI GPT-5.4 Mini",
      "agent": "openai-54-mini",
      "template": "Use the selected verified OpenAI 5.x model for this task.\n\nTask input:\n$ARGUMENTS"
    },
    "oai-5-mini": {
      "description": "Run task with verified OpenAI GPT-5 Mini",
      "agent": "openai-5-mini",
      "template": "Use the selected verified OpenAI 5.x model for this task.\n\nTask input:\n$ARGUMENTS"
    },
    "oai-55": {
      "description": "Run task with verified OpenAI GPT-5.5",
      "agent": "openai-55",
      "template": "Use the selected verified OpenAI 5.x model for this task.\n\nTask input:\n$ARGUMENTS"
    },
    "dsk-flash": {
      "description": "Run task with verified DeepSeek V4 Flash",
      "agent": "deepseek-flash",
      "template": "Use the selected verified DeepSeek model for this task.\n\nTask input:\n$ARGUMENTS"
    },
    "dsk-pro": {
      "description": "Run task with verified DeepSeek V4 Pro",
      "agent": "deepseek-pro",
      "template": "Use the selected verified DeepSeek model for this task.\n\nTask input:\n$ARGUMENTS"
    },
    "img": {
      "description": "Generate or edit images with the local gpt-image-2 MCP",
      "template": "Use the local `fastaicode-image` MCP tools for this image task.\n\nRules:\n- If the request is for a new image, call `fastaicode-image_generate_image`.\n- If the request includes an existing local image path to modify, call `fastaicode-image_edit_image`.\n- Default to `model: \"gpt-image-2\"` unless the user explicitly requests another model.\n- Default to `size_preset: \"1k\"` unless the user explicitly requests another size.\n- After the tool succeeds, respond concisely with the saved path and any useful revised prompt.\n\nTask input:\n$ARGUMENTS"
    },
    "new-session": {
      "description": "Generate a paste-ready prompt for continuing the current task in a new session",
      "agent": "plan",
      "template": "Use the `session-restart-prompt` skill.\n\nGoal:\nGenerate exactly one paste-ready prompt for a fresh session from the current governance files and current task state.\n\nRules:\n- Read `AGENTS.md`, `CURRENT_TASK.md`, and only the relevant parts of `DECISIONS.md` and `AI_GUIDE.md`.\n- Read at most 1 to 3 directly related files when they are clearly identified.\n- Prefer durable file state over chat replay.\n- Do not guess missing facts; mark them as `[待确认]`.\n- Output exactly one paste-ready prompt using the skill's fixed template, with no preface or trailing explanation unless the user explicitly asks.\n\nTask input:\n$ARGUMENTS"
    },
    "vibe": {
      "description": "Run the governed vibe runtime for plan-first work",
      "agent": "vibe-plan",
      "template": "Use `references/ai/subagent-prompt-template.md` as the canonical dispatch structure. This command is only a lightweight wrapper for plan-first governed work under `vibe`.\n\nTask input:\n$ARGUMENTS"
    },
    "vibe-implement": {
      "description": "Run the governed vibe runtime for implementation-first work",
      "agent": "vibe-implement",
      "template": "Use `references/ai/subagent-prompt-template.md` as the canonical dispatch structure. This command is only a lightweight wrapper for implementation-first governed work under `vibe`.\n\nTask input:\n$ARGUMENTS"
    },
    "vibe-review": {
      "description": "Run the governed vibe runtime for review-first work",
      "agent": "vibe-review",
      "template": "Use `references/ai/subagent-prompt-template.md` as the canonical dispatch structure. This command is only a lightweight wrapper for review-first governed work under `vibe`.\n\nTask input:\n$ARGUMENTS"
    }
  },
  "instructions": [
    "~/.config/opencode/rules/*.md",
    "~/.config/opencode/rules/ai/*.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 100000
  }
}
