{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "See README.md for setup instructions. Customize provider baseURLs/apiKeys and MCP server paths (marked YOUR_PATH) before use.",
  "provider": {
    "openai": {
      "options": {
        "baseURL": "https://api.openai.com/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-5.4": {
          "options": { "reasoningEffort": "high" }
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "whitelist": ["deepseek-v4-flash", "deepseek-v4-pro", "deepseek-v4-flash-vision-exp"],
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "deepseek-v4-pro":  { "name": "DeepSeek V4 Pro" },
        "deepseek-v4-flash-vision-exp": {
          "name": "DeepSeek V4 Flash Vision",
          "limit": { "context": 65536, "input": 65536, "output": 8192 }
        }
      }
    }
  },
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-pro",
  "permission": "allow",
  "share": "disabled",
  "plugins": ["./plugins/session-governance", "./plugins/verify-gates"],
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://context7-mcp--upstash.run.tools",
      "enabled": true
    },
    "repo-audit": {
      "type": "local",
      "command": ["python3", "YOUR_PATH/mcp_repo-audit/server/mcp_server.py"]
    },
    "sequential-thinking": {
      "type": "remote",
      "url": "https://server.smithery.ai/@smithery-ai/server-sequential-thinking",
      "enabled": true
    },
    "fastaicode-image": {
      "type": "local",
      "command": ["python3", "YOUR_PATH/fastaicode-image-mcp/server/mcp_server.py"],
      "environment": {
        "FASTAICODE_API_KEY": "{env:FASTAICODE_API_KEY}",
        "FASTAICODE_BASE_URL": "https://api.openai.com/v1"
      },
      "timeout": 120000
    },
    "brave-search": {
      "type": "local",
      "command": ["npx", "-y", "@brave/brave-search-mcp-server", "--transport", "stdio"],
      "environment": { "BRAVE_API_KEY": "{env:BRAVE_API_KEY}" },
      "enabled": true,
      "timeout": 120000
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": true,
      "timeout": 120000
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}" }
    },
    "serena": {
      "type": "local",
      "command": ["serena", "start-mcp-server", "--project-from-cwd", "--open-web-dashboard", "false"],
      "enabled": true,
      "timeout": 120000
    }
  },
  "agent": {
  "openai-56-sol": {
    "description": "OpenAI GPT-5.6 Sol，可切换模型入口",
    "model": "openai/gpt-5.6-sol"
  },
  "deepseek-flash": {
    "description": "DeepSeek V4 Flash，可切换模型入口",
    "model": "deepseek/deepseek-v4-flash"
  },
  "deepseek-pro": {
    "description": "DeepSeek V4 Pro，可切换模型入口",
    "model": "deepseek/deepseek-v4-pro"
  },
  "qwen": {
    "description": "Qwen3.8 Max，可切换模型入口",
    "model": "deepseek/qwen3.8-max"
  },
  "explore": {
    "disable": true
  },
  "general": {
    "disable": true
  },
  "deepseek-vision": {
    "description": "DeepSeek V4 Flash Vision，视觉输入模型入口（识图/图像理解）",
    "model": "deepseek/deepseek-v4-flash-vision-exp"
  }
},
  "command": {
  "oai-56-sol": {
    "description": "Run task with GPT-5.6 Sol",
    "agent": "openai-56-sol",
    "template": "Use the selected GPT-5.6 Sol model.\n\nTask input:\n$ARGUMENTS"
  },
  "dsk-flash": {
    "description": "Run task with DeepSeek V4 Flash",
    "agent": "deepseek-flash",
    "template": "Use the selected DeepSeek model for this task.\n\nTask input:\n$ARGUMENTS"
  },
  "dsk-pro": {
    "description": "Run task with DeepSeek V4 Pro",
    "agent": "deepseek-pro",
    "template": "Use the selected DeepSeek model for this task.\n\nTask input:\n$ARGUMENTS"
  },
  "qwen": {
    "description": "Run task with Qwen3.8 Max",
    "agent": "qwen",
    "template": "Use the selected Qwen model for this task.\n\nTask input:\n$ARGUMENTS"
  },
  "img": {
    "description": "Generate or edit images with the local gpt-image-2 MCP",
    "template": "Use the local `fastaicode-image` MCP tools for this image task.\n\nRules:\n- If the request is for a new image, call `fastaicode-image_generate_image`.\n- If the request includes an existing local image path to modify, call `fastaicode-image_edit_image`.\n- Default to `size_preset: \"1k\"` unless the user explicitly requests another size.\n\nTask input:\n$ARGUMENTS"
  },
  "new-session": {
    "description": "Generate a paste-ready prompt for continuing the current task in a new session",
    "agent": "plan",
    "template": "Use the `session-restart-prompt` skill.\n\nGoal:\nGenerate exactly one paste-ready prompt for a fresh session from the current governance files and current task state.\n\nRules:\n- Read `AGENTS.md`, `CURRENT_TASK.md`, and only the relevant parts of `DECISIONS.md` and `AI_GUIDE.md`.\n- Read at most 1 to 3 directly related files when they are clearly identified.\n- Prefer durable file state over chat replay.\n- Do not guess missing facts; mark them as `[待确认]`.\n- Output exactly one paste-ready prompt using the skill's fixed template, with no preface or trailing explanation unless the user explicitly asks.\n\nTask input:\n$ARGUMENTS"
  },
  "ci-check": {
    "description": "Check CI status for the current branch via gh CLI",
    "template": "Check CI ground truth for the current repo/branch.\n\nSteps:\n1. Run `gh pr checks` (or `gh run list --limit 5` if no PR).\n2. Report each check's name + state (success/failure/pending).\n3. If any check failed, state the failure evidence.\n\nTask input:\n$ARGUMENTS"
  },
  "xreview": {
    "description": "Cross-model review: independent review by two different models, compare conclusions",
    "agent": "openai-56-sol",
    "template": "Perform a cross-model review of the given change.\n\nRules:\n- Read the change (diff or files) and review it as the PRIMARY reviewer.\n- Then dispatch a SECOND independent review by a different model.\n- Compare conclusions, list agreements and disagreements.\n\nTask input:\n$ARGUMENTS"
  },
  "vision": {
    "description": "Visual analysis with DeepSeek V4 Flash Vision: describe/analyze/review an image or screenshot",
    "agent": "deepseek-vision",
    "template": "Load the `vision-analyze` skill and analyze the image(s) in the task.\n\nRules:\n- Confirm the image exists locally; if >300KB, compress first.\n- Give a clear task: describe / review / diagnose / design-to-code.\n- For UI screenshot review, apply `ux-design` five-layer laws and return a structured issue list.\n\nTask input:\n$ARGUMENTS"
  }
},
  "instructions": ["~/.config/opencode/rules/ai/*.md"],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 100000
  }
}
