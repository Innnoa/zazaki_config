#!/usr/bin/env bash
set -euo pipefail

# ------------------------------------------------------------------
# pre-commit hook: block AI-generated files from entering git
#
# Uses the same two detection pathways as repo-audit:
#   1. Static path patterns (CURRENT_TASK.md, DECISIONS.md, etc.)
#   2. Dynamic header marker scan (<!-- ai-generated)
#
# Install: ln -s ~/.config/opencode/scripts/git-hooks/pre-commit .git/hooks/pre-commit
#          or   cp  ~/.config/opencode/scripts/git-hooks/pre-commit .git/hooks/pre-commit
# ------------------------------------------------------------------

ROOT_DIR=$(git rev-parse --show-toplevel)

# --- static path patterns (aligned with repo-audit AI_ARTIFACTS) ---
AI_PATTERNS=(
    ".codex/"
    ".claude/"
    "AI_GUIDE.md"
    "CURRENT_TASK.md"
    "DECISIONS.md"
    "handoff/"
    "outputs/runtime/"
)

# --- dynamic marker ---
MARKER="<!-- ai-generated"

# --- collect staged files ---
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
BLOCKED=()

for file in $STAGED; do
    # 1) static path check
    for pat in "${AI_PATTERNS[@]}"; do
        if [[ "$file" == "$pat" ]] || [[ "$file" == "$pat"* ]]; then
            BLOCKED+=("$file  [static-path: $pat]")
            break
        fi
    done

    # 2) dynamic marker check (only if not already flagged)
    if ! printf '%s\n' "${BLOCKED[@]}" | grep -qFx "$file  [static-path: $pat]" 2>/dev/null; then
        if [[ -f "$ROOT_DIR/$file" ]]; then
            first_line=$(head -n 1 "$ROOT_DIR/$file" 2>/dev/null || true)
            if [[ "$first_line" == *"$MARKER"* ]]; then
                BLOCKED+=("$file  [marker: $MARKER]")
            fi
        fi
    fi
    true  # reset check
done

if [[ ${#BLOCKED[@]} -gt 0 ]]; then
    echo ""
    echo "  repo-audit pre-commit: BLOCKED"
    echo "  These files appear to be AI-generated artifacts:"
    echo ""
    for entry in "${BLOCKED[@]}"; do
        echo "    $entry"
    done
    echo ""
    echo "  Either remove them from the staging area or add them to .gitignore."
    echo ""
    exit 1
fi

# --- governance file change check ---
GOV_FILES=$(echo "$STAGED" | grep -E '^(rules/ai/|workflows/ai/|references/ai/|AGENTS\.md|opencode\.json|agents/|plugins/session-governance\.ts|scripts/git-hooks/)' || true)
if [[ -n "$GOV_FILES" ]]; then
    echo ""
    echo "  → 检测到治理文件变更，运行快速烟雾检查..."
    SCRIPT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
    if bash "$SCRIPT_DIR/scripts/ai-governance-smoke-check.sh" 2>&1; then
        echo "  ✓ 治理烟雾检查通过"
    else
        echo ""
        echo "  ⚠ 治理烟雾检查未通过，请修复后再提交。"
        echo "    手动运行: bash scripts/ai-governance-smoke-check.sh"
        echo ""
        exit 1
    fi
    if bash "$SCRIPT_DIR/scripts/test-trigger.sh" 2>&1; then
        echo "  ✓ 路由引用检查通过"
    else
        echo ""
        echo "  ⚠ 路由引用检查未通过。"
        echo "    手动运行: bash scripts/test-trigger.sh"
        echo ""
        exit 1
    fi
fi

exit 0
